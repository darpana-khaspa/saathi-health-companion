# Environment configuration template for Saathi Health Companion
# Copy to .env for local overrides (never commit actual secrets)

ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0

# Optional: Persistent SQLite Database Path (for Render Persistent Disk)
# DATABASE_PATH=/var/data/saathi_records.db

# Optional: Comma-separated extra allowed CORS origins
# CORS_ORIGINS=https://my-custom-domain.com
